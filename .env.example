# APP_URL: The public origin where this application is hosted.
APP_URL="http://localhost:3000"

# ADMIN CREDENTIALS (required for /admin-portal login)
# Generate a bcrypt hash with:
# node -e "const b=require('bcryptjs'); console.log(b.hashSync('YOUR_STRONG_PASSWORD', 12));"
ADMIN_USERNAME="your_username"
ADMIN_PASSWORD_HASH="generated_bcrypt_hash"

# SESSION & SECURITY SECRETS (use long random strings, e.g. 64 hex chars)
JWT_SECRET="long_random_string"
CSRF_SECRET="another_long_random_string"

# DATABASE (SQLite file path)
DATABASE_PATH="./data/portfolio.db"

# CORS (comma-separated list of allowed origins in addition to APP_URL)
ALLOWED_ORIGINS=""

# OPTIONAL SERVER-SIDE INTEGRATIONS (never expose to frontend)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
